generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          String       @id
  name        String
  description String
  githubUrl   String
  skills      Skill[]
  experience  Experience[]
  projects    Project[]
}

model Skill {
  id        String  @id
  name      String
  category  String
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Experience {
  id           String  @id
  company      String
  position     String
  period       String
  achievements String
  profileId    String
  profile      Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Project {
  id          String  @id
  name        String
  description String
  url         String
  profileId   String
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}
